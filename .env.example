# ---------------------------------------------------------------------------
# VyaparAI environment configuration
# Copy this file to `.env` (in the project root / server folder) and fill in
# real credentials only where you have them. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=4000
NODE_ENV=development
# Frontend origin allowed to call the API with cookies (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# true only when serving over HTTPS
COOKIE_SECURE=false
# Random long string used to derive token hashes (generate your own!)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Leave empty to run the in-memory DEMO store (no persistence across restarts)
MONGODB_URI=mongodb://127.0.0.1:27017/vyaparai

# --- Password hashing ---
BCRYPT_ROUNDS=12

# --- File uploads (private local storage by default) ---
# UPLOAD_DIR=/absolute/path/to/server/uploads

# --- External integrations (all optional) ---
# OTP / SMS provider (e.g. MSG91, Twilio) — required to really send OTPs
OTP_PROVIDER=
OTP_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=

# Email provider (e.g. SendGrid, SES, Resend) — for reset & activation links
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Map provider (Google Maps / Mapbox) — enables the map preview
MAP_PROVIDER=
MAP_API_KEY=

# Authorised GST / business verification provider — real verification results
VERIFICATION_PROVIDER=
VERIFICATION_API_KEY=

# Private object storage (optional; falls back to private local disk storage)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# LLM provider for the AI Business Assistant (OPENAI or ANTHROPIC)
AI_PROVIDER=
AI_API_KEY=

# Demo mode: 'true' forces simulated OTP/verification, 'false' requires
# providers to be configured. Unset = automatic (demo until providers exist).
DEMO_MODE=
